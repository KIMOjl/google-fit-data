# Google Fit Data Project - Environment Variables
# Copy this to .env and fill in your values

# Google OAuth Credentials (required)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google Fit Token File Path (optional, defaults to .google_fit_tokens.json)
TOKEN_PATH=.google_fit_tokens.json

# Optional: Telegram Bot Token (if you want to send reports to Telegram)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: OpenAI API Key (if using AI-powered insights)
# OPENAI_API_KEY=your_openai_key_here

# Optional: Data Directory (defaults to ./data)
# DATA_DIR=./data

# Optional: Log Level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
